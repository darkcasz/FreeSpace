{
  "name": "freespace",
  "version": "0.4.0",
  "private": true,
  "description": "CertaFreeSpace \u2014 an\u00e1lisis de almacenamiento y mantenimiento de Windows",
  "author": "CertaSoft",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "publish:updates": "node scripts/publish-github.mjs"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "electron-updater": "6.8.11"
  },
  "build": {
    "appId": "com.freespace.desktop",
    "productName": "CertaFreeSpace",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "build/brand/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CertaFreeSpace-${version}-Windows-x64-Setup.${ext}",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CertaFreeSpace",
      "runAfterFinish": true,
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082",
      "include": "build/installer.nsh",
      "useZip": true,
      "differentialPackage": false,
      "installerIcon": "build/brand/icon.ico",
      "uninstallerIcon": "build/brand/icon.ico",
      "installerHeaderIcon": "build/brand/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "darkcasz",
        "repo": "FreeSpace",
        "releaseType": "release"
      }
    ],
    "executableName": "FreeSpace",
    "copyright": "Copyright \u00a9 2026 CertaSoft"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/darkcasz/FreeSpace.git"
  }
}
